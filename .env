# Kafka
KAFKA_BOOTSTRAP_SERVERS=localhost:9092

# Topics (optional override)
WEATHER_TOPIC=weather.context
WIND_TOPIC=weather.wind
AIR_QUALITY_TOPIC=air.quality
SENSOR_MEASUREMENT_TOPIC=sensor.measurements
SENSOR_HEALTH_TOPIC=sensor.health
ALARM_TOPIC=alerts.fire

# Intervals in seconds (optional)
SENSOR_INTERVAL_SEC=1
HEALTH_INTERVAL_SEC=5
WEATHER_INTERVAL_SEC=5
ALARM_INTERVAL_SEC=30
